# Copy to .env (git-ignored) and fill in. TESTNET KEYS ONLY. Never commit .env or paste keys anywhere.

# --- Sepolia (enforcement chain): Guard deploy, HexFence Pay reads ---
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEMO_SAFE_ADDRESS=
ETHERSCAN_API_KEY=

# --- Ethereum mainnet (evidence source, read-only): detector getLogs ---
MAINNET_RPC_URL=

# --- Arkiv Rabdi testnet: access key from hub.arkiv.network/access-keys, tGLM from the faucet ---
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=

# --- Browser apps (Vite exposes only VITE_* names; these are public values, not secrets) ---
VITE_ARKIV_PUBLISHER=
VITE_GUARD_ADDRESS=
VITE_SEPOLIA_RPC_URL=
# optional: an Arkiv access key for the browser apps (public, restrict it to your origins at hub.arkiv.network)
VITE_ARKIV_ACCESS_KEY=
# explorer "Verify on Ethereum" (T9): a mainnet RPC the browser may call
VITE_MAINNET_RPC_URL=

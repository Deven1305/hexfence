{
  "name": "@hexfence/pay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "HexFence Pay: builds a Safe payment, shows the verdict before signing, then executes through Protocol Kit.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run --exclude \"e2e/**\"",
    "test:e2e": "node e2e/run.mjs",
    "test:live": "node e2e/live.mjs"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@hexfence/arkiv": "workspace:*",
    "@hexfence/shared": "workspace:*",
    "@hexfence/ui": "workspace:*",
    "@safe-global/protocol-kit": "8.0.11",
    "@safe-global/safe-apps-sdk": "9.1.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}

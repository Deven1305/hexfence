{
  "manifest_version": 3,
  "name": "HexFence interception spike",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "description": "Review Safe payment requests on app.safe.global before forwarding to the wallet.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["https://app.safe.global/*"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://app.safe.global/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "ISOLATED" }
  ]
}
